# =============================================================
# .env.example
# Template for environment variables (copy to .env)
# DO NOT commit real secrets or .env to version control.
# =============================================================

# PostgreSQL Credentials
POSTGRES_DB=ecommerce
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=ecom_secure_password_here
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Kafka Configuration
BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=ecommerce-events
KAFKA_DLQ_TOPIC=ecommerce-dead-letter

# Producer Settings
SCENARIO=CHAOS
RATE=35.0
MAX_EVENTS=0
